---
import { skillCategories, featuredSkills } from '../data/content';
---
<section class="layer max-w-295 mx-auto px-7 pt-25 pb-20 border-b border-border opacity-0 translate-y-4 transition-[opacity,transform] duration-600 ease-out [&.in-view]:opacity-100 [&.in-view]:translate-y-0 last-of-type:border-b-0" id="skills" data-layer-name="Habilidades">
    <div class="eyebrow font-mono text-[12.5px] text-accent tracking-[0.08em] uppercase flex items-center gap-2.5 mb-4.5 before:content-[''] before:w-6 before:h-0.5 before:bg-linear-to-r before:from-accent before:to-secondary before:rounded-sm">04</div>
    <h2 class="section-title text-[1.7rem] sm:text-[2.1rem] font-bold mb-2 font-display">Tecnologías</h2>
    <p class="section-subtitle text-text-muted mb-12 text-[1.05rem]">Herramientas con las que trabajo día a día</p>

    <div class="flex flex-col gap-7">
        {skillCategories.map((cat) => (
            <div>
                <div class="font-mono text-[11.5px] text-text-muted uppercase tracking-[0.06em] mb-3.5">{cat.label}</div>
                <div class="flex flex-wrap gap-2.5">
                    {cat.items.map((item) => {
                        const isFeatured = featuredSkills.includes(item);
                        return (
                            <span
                                class:list={[
                                    "text-sm font-medium px-4.5 py-2.5 rounded-full transition-all duration-300 hover:-translate-y-1 hover:border-accent hover:text-accent hover:shadow-card",
                                    isFeatured
                                        ? "bg-secondary-dim border-2 border-secondary text-text-primary font-semibold"
                                        : "bg-bg-card border border-border text-text-primary",
                                ]}
                            >
                                {item}
                            </span>
                        );
                    })}
                </div>
            </div>
        ))}
    </div>
</section>